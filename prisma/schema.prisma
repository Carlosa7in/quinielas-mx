generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id               String           @id @default(cuid())
  nombre           String
  username         String?          @unique
  email            String           @unique
  telefono         String?
  password         String
  rol              String           @default("user")
  puntoVenta       String?
  codigoRef        String?          @unique  // link de referido: /quiniela?ref=CODIGO
  createdAt        DateTime         @default(now())
  quinielas        Quiniela[]
  cuentasBancarias CuentaBancaria[]
}

model Jornada {
  id               String     @id @default(cuid())
  numero           Int
  nombre           String?
  temporada        String
  liga             String     @default("Liga MX")
  estado           String     @default("abierta")
  fechaInicio      DateTime
  fechaFin         DateTime
  createdAt        DateTime   @default(now())
  bolsa2Acumulada  Float      @default(0)
  acumulaciones2   Int        @default(0)
  partidos         Partido[]
  quinielas        Quiniela[]
}

model Partido {
  id           String   @id @default(cuid())
  jornadaId    String
  jornada      Jornada  @relation(fields: [jornadaId], references: [id])
  liga         String   @default("Liga MX")
  equipoLocal  String
  equipoVisita String
  fechaHora    DateTime
  resultado    String?
  golesLocal   Int?
  golesVisita  Int?
  orden        Int      @default(0)
  espnId       String?
  picks        Pick[]
}

model Cliente {
  id        String     @id @default(cuid())
  telefono  String     @unique
  nombre    String
  quinielas Quiniela[]
}

model Vendedor {
  id        String     @id @default(cuid())
  nombre    String
  codigo    String     @unique   // slug corto, ej. "CARLOS"
  activo    Boolean    @default(true)
  createdAt DateTime   @default(now())
  quinielas Quiniela[]
}

model Quiniela {
  id              String          @id @default(cuid())
  folio           String          @unique
  usuarioId       String?
  usuario         Usuario?        @relation(fields: [usuarioId], references: [id])
  clienteId       String?
  cliente         Cliente?        @relation(fields: [clienteId], references: [id])
  jornadaId       String
  jornada         Jornada         @relation(fields: [jornadaId], references: [id])
  vendedorId      String?
  vendedor        Vendedor?       @relation(fields: [vendedorId], references: [id])
  cuentaDestinoId String?
  cuentaDestino   CuentaBancaria? @relation(fields: [cuentaDestinoId], references: [id])
  nombreCliente   String?
  telefonoCliente String?
  canal           String          @default("online")
  monto           Float           @default(20.0)
  estado          String          @default("pendiente")
  estadoPago      String          @default("pendiente") // "pendiente" | "confirmado" | "no_realizado"
  referenciaPago  String?
  puntos          Int?
  aciertos        Int?
  premio          Float?
  createdAt       DateTime        @default(now())
  picks           Pick[]
}

model CuentaBancaria {
  id        String     @id @default(cuid())
  usuarioId String
  usuario   Usuario    @relation(fields: [usuarioId], references: [id])
  banco     String     // "BBVA", "Banorte", "OXXO Pay", etc.
  titular   String
  clabe     String?    // CLABE 18 dígitos
  numero    String?    // últimos 4 dígitos (opcional, para mostrar)
  tipo      String     @default("transferencia") // "transferencia" | "oxxo"
  activa    Boolean    @default(true)
  orden     Int        @default(0)
  createdAt DateTime   @default(now())
  quinielas Quiniela[]
}

model Pick {
  id         String   @id @default(cuid())
  quinielaId String
  quiniela   Quiniela @relation(fields: [quinielaId], references: [id])
  partidoId  String
  partido    Partido  @relation(fields: [partidoId], references: [id])
  prediccion String
  acertado   Boolean?
}

model Equipo {
  id      String  @id @default(cuid())
  nombre  String
  liga    String
  logoUrl String  @default("")

  @@unique([nombre, liga])
}

model PagoComision {
  id          String   @id @default(cuid())
  usuarioId   String
  jornadaId   String
  monto       Float    @default(0)
  pagadoEn    DateTime @default(now())
  pagadoPor   String?  // id del superadmin que registró el pago
  createdAt   DateTime @default(now())

  @@unique([usuarioId, jornadaId])
}

model PreRegistro {
  id         String   @id @default(cuid())
  vendedorId String   // usuario.id del vendedor de tienda
  jornadaId  String
  nombre     String
  telefono   String
  picks      String   // JSON array: ["L","E","V",...] uno por partido en orden
  createdAt  DateTime @default(now())
  usado      Boolean  @default(false)
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
